# Homed runs with NO keys by default: a local JSON store in apps/web/.data and demo sign-in.
# Everything below is optional.

# Storage backend: json (default) | supabase
HOMED_BACKEND=json
# Where the JSON store, dev session secret and dev encryption key live (default: <cwd>/.data)
# HOMED_DATA_DIR=

# Required in production / supabase mode. 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# HOMED_ENCRYPTION_KEY=
# HOMED_SESSION_SECRET=

# Demo sign-in (no email check) is off in production builds (`next start`) unless this is 1.
# Set it only for demos; real deployments use Supabase sign-in.
# HOMED_ALLOW_DEMO_SIGNIN=1

# Comma-separated emails that get admin (review moderation) access
# HOMED_ADMIN_EMAILS=

# Pin "today" for demos and tests (YYYY-MM-DD)
# HOMED_TODAY=

# Supabase (only when HOMED_BACKEND=supabase)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Schema holding Homed's tables: public (own project) or homed (sharing a project; see supabase/README.md)
# HOMED_SUPABASE_SCHEMA=homed
# Sign-in: local (demo) | supabase (magic link). Default follows HOMED_BACKEND.
# HOMED_AUTH=local
# HOMED_APP_URL=http://localhost:3010

# Walk-time precompute (packages/data): OSRM foot-routing server. Default: estimate only.
# OSRM_URL=http://localhost:5000
